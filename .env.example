# Copy to a path you choose and pass it with --config, or export these.
# Never commit a real env file. Example values only — no real credentials
# are in this repository.
S3_ENDPOINT=https://s3.example.invalid:3900
S3_BUCKET=pastebin-test
S3_REGION=us-east-1
# Set each credential directly, or set its _FILE alternative. Do not set both.
S3_ACCESS_KEY_ID=EXAMPLE-ACCESS-KEY
# S3_ACCESS_KEY_ID_FILE=/home/you/.config/dayfly/access-key-id
S3_SECRET_ACCESS_KEY=EXAMPLE-SECRET-KEY
# S3_SECRET_ACCESS_KEY_FILE=/home/you/.config/dayfly/secret-access-key
# Optional: defaults are shown here.
# Text cap: MCP store_text, the human text form, and uploads with no filename.
# DAYFLY_MAX_TEXT_BYTES=10485760
# File cap: uploads with a filename (X-Filename or multipart filename).
# DAYFLY_MAX_FILE_BYTES=1073741824
# Total cap for one paste, including every appended segment.
# DAYFLY_MAX_PASTE_BYTES=1073741824
# Maximum bytes that one text search reads before it returns truncated.
# DAYFLY_SEARCH_MAX_BYTES=67108864
# Default TTL in positive whole days when a request does not set X-TTL or ttl.
# DAYFLY_DEFAULT_TTL_DAYS=7
# Default window for the paste list, in whole days, ending today in UTC.
# DAYFLY_LIST_DEFAULT_DAYS=2
# Clamp the expiry by the paste size. Off keeps the requested TTL exactly.
# DAYFLY_RETENTION_BY_SIZE=false
# Retention in whole days at the size cap and at zero bytes.
# DAYFLY_RETENTION_MIN_DAYS=30
# DAYFLY_RETENTION_MAX_DAYS=365
# DAYFLY_HTTP_BIND=127.0.0.1:8080
# Show the three-word alias in the human UI (create redirects, view, list).
# Defaults to true. This is a display setting only; the API still returns
# the words field. Set to false to hide the words.
# DAYFLY_SHOW_WORDS=true
# Show the canonical date and ID under the alias in the paste list.
# Defaults to false. Set to true to show the internal path.
# DAYFLY_SHOW_INTERNAL_PATHS=false
# Number the lines of a text paste on the view page. Off by default.
# DAYFLY_VIEW_LINE_NUMBERS=false
# Optional bearer token for the binary's own HTTP routes only,
# including /mcp. This is NOT the Garage credential and does not replace
# it. When set, HTTP clients must send: Authorization: Bearer <token>
# When unset, HTTP mode relies on private-network / localhost deployment.
# DAYFLY_HTTP_BEARER_TOKEN=EXAMPLE-BEARER-TOKEN-ONLY
# DAYFLY_HTTP_BEARER_TOKEN_FILE=/home/you/.config/dayfly/bearer-token
# Return a per-paste management token at creation. The token authorizes
# DELETE and PATCH for that paste. The bearer token remains universal.
# DAYFLY_PASTE_TOKENS=false
# Optional directory for the MCP local-path tools (store_file, fetch_file).
# It must exist, or startup fails. When set, both tools refuse any path
# outside it. When unset, stdio accepts any readable path and HTTP /mcp
# refuses both tools.
# DAYFLY_MCP_LOCAL_ROOT=/var/lib/dayfly/files
# Optional favicon served at /favicon.ico. Read at startup; 1 MiB or smaller.
# DAYFLY_FAVICON_PATH=/var/lib/dayfly/favicon.ico
# Optional robots.txt served at /robots.txt. Read at startup; UTF-8, 1 MiB or smaller.
# DAYFLY_ROBOTS_TXT_PATH=/var/lib/dayfly/robots.txt
# Optional security.txt served at /.well-known/security.txt. Read at startup;
# UTF-8, 1 MiB or smaller. Include Contact: and Expires: per RFC 9116.
# DAYFLY_SECURITY_TXT_PATH=/var/lib/dayfly/security.txt
# Site name for the human UI footer. Unset keeps "dayfly — internal use only".
# DAYFLY_SITE_NAME=dayfly
# Optional takedown contact and acceptable-use URL for the footer.
# DAYFLY_CONTACT=abuse@example.com
# DAYFLY_AUP_URL=https://example.com/acceptable-use
# Listing on every transport. Set to false on a public instance.
# DAYFLY_LIST_ENABLED=true
# Explicit TTL bounds in whole days, and the browser selector choices.
# DAYFLY_MIN_TTL_DAYS=0
# DAYFLY_MAX_TTL_DAYS=3650
# DAYFLY_TTL_CHOICES=1,3,7,14,30,90
