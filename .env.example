# Copy to .env (never commit a real .env) or export these variables.
# Placeholders only — no real credentials are in this repository.
S3_ENDPOINT=https://s3.example.invalid:3900
S3_BUCKET=pastebin-test
S3_REGION=us-east-1
# Set each credential directly, or set its _FILE alternative. Do not set both.
S3_ACCESS_KEY_ID=EXAMPLE-ACCESS-KEY
# S3_ACCESS_KEY_ID_FILE=/home/you/.config/dayfly/access-key-id
S3_SECRET_ACCESS_KEY=EXAMPLE-SECRET-KEY
# S3_SECRET_ACCESS_KEY_FILE=/home/you/.config/dayfly/secret-access-key
# Optional: defaults are shown here.
# Text cap: MCP store_text, the human text form, and uploads with no filename.
# DAYFLY_MAX_TEXT_BYTES=10485760
# File cap: uploads with a filename (X-Filename or multipart filename).
# DAYFLY_MAX_FILE_BYTES=1073741824
# Default TTL in positive whole days when a request does not set X-TTL or ttl.
# DAYFLY_DEFAULT_TTL_DAYS=7
# DAYFLY_HTTP_BIND=127.0.0.1:8080
# Optional bearer token for the binary's own HTTP routes only,
# including /mcp. This is NOT the Garage credential and does not replace
# it. When set, HTTP clients must send: Authorization: Bearer <token>
# When unset, HTTP mode relies on private-network / localhost deployment.
# DAYFLY_HTTP_BEARER_TOKEN=EXAMPLE-BEARER-TOKEN-ONLY
